<servlet-name>LoginServlet</servlet-name>
<servlet-class>com.exam.LoginServlet</servlet-class>
</servlet>
<servlet-mapping>
<servlet-name>LoginServlet</servlet-name>
<url-pattern>/LoginServlet</url-pattern>
</servlet-mapping>

<servlet>
<servlet-name>StartExamServlet</servlet-name>
<servlet-class>com.exam.StartExamServlet</servlet-class>
</servlet>
<servlet-mapping>
<servlet-name>StartExamServlet</servlet-name>
<url-pattern>/StartExamServlet</url-pattern>
</servlet-mapping>

<servlet>
<servlet-name>SubmitExamServlet</servlet-name>
<servlet-class>com.exam.SubmitExamServlet</servlet-class>
</servlet>
<servlet-mapping>
<servlet-name>SubmitExamServlet</servlet-name>
<url-pattern>/SubmitExamServlet</url-pattern>
</servlet-mapping>

<servlet>
<servlet-name>ResultServlet</servlet-name>
