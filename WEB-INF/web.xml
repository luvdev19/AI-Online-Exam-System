<url-pattern>/ProfileServlet</url-pattern>
</servlet-mapping>

<servlet>
<servlet-name>SnapshotServlet</servlet-name>
<servlet-class>com.exam.SnapshotServlet</servlet-class>
</servlet>
<servlet-mapping>
<servlet-name>SnapshotServlet</servlet-name>
<url-pattern>/SnapshotServlet</url-pattern>
</servlet-mapping>

<servlet>
<servlet-name>CheatMonitorServlet</servlet-name>
<servlet-class>com.exam.CheatMonitorServlet</servlet-class>
</servlet>
<servlet-mapping>
<servlet-name>CheatMonitorServlet</servlet-name>
<url-pattern>/CheatMonitorServlet</url-pattern>
</servlet-mapping>

<servlet>
<servlet-name>LeaderboardServlet</servlet-name>
<servlet-class>com.exam.LeaderboardServlet</servlet-class>
