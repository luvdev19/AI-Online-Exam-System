<servlet-class>com.exam.ViewQuestionsServlet</servlet-class>
</servlet>

<servlet-mapping>
<servlet-name>ViewQuestionsServlet</servlet-name>
<url-pattern>/ViewQuestionsServlet</url-pattern>
</servlet-mapping>

<servlet>
<servlet-name>ReleaseResultServlet</servlet-name>
<servlet-class>com.exam.ReleaseResultServlet</servlet-class>
</servlet>

<servlet-mapping>
<servlet-name>ReleaseResultServlet</servlet-name>
<url-pattern>/ReleaseResultServlet</url-pattern>
</servlet-mapping>

<servlet>
<servlet-name>LogoutServlet</servlet-name>
<servlet-class>com.exam.LogoutServlet</servlet-class>
</servlet>

<servlet-mapping>
<servlet-name>LogoutServlet</servlet-name>
